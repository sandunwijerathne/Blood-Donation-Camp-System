# Local overrides for the scheduled backup.
#
# Copy to  scripts/backup.env  and edit. That file is git-ignored, so
# it never reaches the repository.
#
# Read by scripts/backup-windows.cmd. On Linux, export these in the
# cron entry instead.
#
# Format: KEY=VALUE, one per line. Lines starting with # are ignored.
# Do not quote values and do not put spaces around the '='.

# ---- Database user -----------------------------------------------
# Defaults to root only because no least-privilege user exists yet.
# After running docs/create-db-user.sql, switch to the backup account,
# which has SELECT and LOCK TABLES and nothing else:
#
#   DB_USER=bdms_backup
#
# The PASSWORD does not go here. Putting it in an environment variable
# or on the command line makes it readable by every other user on the
# machine via the process list. Use a MySQL option file instead:
#
#   C:\Users\<you>\.my.cnf        (Windows)
#   ~/.my.cnf                     (Linux, chmod 600)
#
#   [client]
#   user=bdms_backup
#   password=the-real-password
#
# mysqldump reads that automatically.
DB_USER=root

# ---- Where archives are written ----------------------------------
# Default is <project>/backups, which .htaccess denies and .gitignore
# excludes. A path on ANOTHER disk is better - a backup on the same
# drive as the database does not survive that drive failing.
#
#   BACKUP_DIR=D:/bdms-backups
#
# Off the machine entirely is better still. A dump holds 823 people's
# names, phone numbers and addresses, so wherever it goes must be at
# least as protected as the server.

# ---- Retention ----------------------------------------------------
# Days to keep. Only files this script's own naming produced are
# deleted.
RETAIN_DAYS=14
